// ═══════════════════════════════════════════════════════════════
// GameVault — Prisma Schema
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────────────────────────────────────────
// AUTH (Auth.js / NextAuth)
// ───────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────────────────────────────────────────────────────────
// ENUMS
// ───────────────────────────────────────────────────────────────

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum LibraryStatus {
  PLAYING
  COMPLETED
  BACKLOG
  DROPPED
}

enum ActivityType {
  LIBRARY_ADD
  WISHLIST_ADD
  REVIEW_POSTED
  RATING_POSTED
  GAME_COMPLETED
  FOLLOW
  ACHIEVEMENT_UNLOCKED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

// ───────────────────────────────────────────────────────────────
// USER
// ───────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  emailVerified DateTime?
  password      String?
  name          String?
  avatarUrl     String?
  bannerUrl     String?
  bio           String?   @db.Text
  role          Role      @default(USER)
  isBanned      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  libraryEntries LibraryEntry[]
  wishlist       Wishlist[]
  reviews        Review[]
  ratings        Rating[]
  comments       Comment[]
  likes          Like[]
  activities     Activity[]
  achievements   UserAchievement[]

  following Follow[] @relation("following")
  followers Follow[] @relation("followers")

  reportsFiled Report[] @relation("reportsFiled")
  reportsAbout Report[] @relation("reportsAbout")

  @@index([username])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ───────────────────────────────────────────────────────────────
// GAME CATALOG
// ───────────────────────────────────────────────────────────────

model Game {
  id          String   @id @default(cuid())
  rawgId      Int?     @unique
  slug        String   @unique
  title       String
  description String   @db.Text
  coverUrl    String
  backdropUrl String?
  trailerUrl  String?
  releaseDate DateTime
  metacritic  Int?
  esrbRating  String?
  website     String?
  isFeatured  Boolean  @default(false)
  isTrending  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  genres      GenreOnGame[]
  platforms   PlatformOnGame[]
  developers  DeveloperOnGame[]
  publishers  PublisherOnGame[]
  screenshots Screenshot[]

  reviews        Review[]
  ratings        Rating[]
  wishlistedBy   Wishlist[]
  libraryEntries LibraryEntry[]

  @@index([title])
  @@index([isFeatured])
  @@index([isTrending])
}

model Screenshot {
  id     String @id @default(cuid())
  url    String
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model Genre {
  id   String @id @default(cuid())
  slug String @unique
  name String @unique

  games GenreOnGame[]
}

model GenreOnGame {
  gameId  String
  genreId String
  game    Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([gameId, genreId])
}

model Platform {
  id     String @id @default(cuid())
  slug   String @unique
  name   String @unique
  family String // PC | PlayStation | Xbox | Nintendo

  games PlatformOnGame[]
}

model PlatformOnGame {
  gameId     String
  platformId String
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@id([gameId, platformId])
}

model Developer {
  id   String @id @default(cuid())
  slug String @unique
  name String @unique

  games DeveloperOnGame[]
}

model DeveloperOnGame {
  gameId      String
  developerId String
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@id([gameId, developerId])
}

model Publisher {
  id   String @id @default(cuid())
  slug String @unique
  name String @unique

  games PublisherOnGame[]
}

model PublisherOnGame {
  gameId      String
  publisherId String
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  @@id([gameId, publisherId])
}

// ───────────────────────────────────────────────────────────────
// LIBRARY / WISHLIST
// ───────────────────────────────────────────────────────────────

model LibraryEntry {
  id          String        @id @default(cuid())
  userId      String
  gameId      String
  status      LibraryStatus @default(BACKLOG)
  progress    Int           @default(0) // 0-100
  hoursPlayed Float         @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId, status])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

// ───────────────────────────────────────────────────────────────
// REVIEWS / RATINGS
// ───────────────────────────────────────────────────────────────

model Rating {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  value     Int // 1-10
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
}

model Review {
  id               String   @id @default(cuid())
  userId           String
  gameId           String
  title            String
  content          String   @db.Text
  isSpoiler        Boolean  @default(false)
  playtimeAtReview Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game     Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]
  reports  Report[]

  @@unique([userId, gameId])
  @@index([gameId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@index([reviewId])
}

// ───────────────────────────────────────────────────────────────
// ACHIEVEMENTS
// ───────────────────────────────────────────────────────────────

model Achievement {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  icon        String // lucide icon name
  tier        String @default("bronze") // bronze | silver | gold | platinum

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

// ───────────────────────────────────────────────────────────────
// ACTIVITY FEED
// ───────────────────────────────────────────────────────────────

model Activity {
  id        String       @id @default(cuid())
  userId    String
  type      ActivityType
  metadata  Json // flexible payload: { gameTitle, gameSlug, rating, achievementName, targetUsername, ... }
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────
// MODERATION
// ───────────────────────────────────────────────────────────────

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  targetUserId String?
  reviewId     String?
  reason       String
  details      String?      @db.Text
  status       ReportStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?

  reporter   User    @relation("reportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser User?   @relation("reportsAbout", fields: [targetUserId], references: [id], onDelete: Cascade)
  review     Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([status])
}
